 //==============================================================================
+// Modern macOS evaluates CGShading functions lazily (e.g. when a layer's
+// display list is replayed), after the SavedState that JUCE 3.0.0 passed as
+// the callback's info may already have changed or been deleted. Give each
+// CGFunction its own copy of the lookup table, released by CoreGraphics.
+namespace
+{
+    struct CGGradientLookupInfo
+    {
+        HeapBlock<PixelARGB> table;
+        int numEntries;
+    };
+
+    void releaseCGGradientLookupInfo (void* info)
+    {
+        delete static_cast<CGGradientLookupInfo*> (info);
+    }
+}
+
 CoreGraphicsContext::CoreGraphicsContext (CGContextRef c, const float h, const float scale)
     : context (c),
       flipHeight (h),
