+        memcpy (info->table, gradientLookupTable, sizeof (PixelARGB) * ((size_t) numGradientLookupEntries + 1));
+
+        // Static, so the callbacks outlive this context too.
+        static const CGFunctionCallbacks callbacks = { 0, &SavedState::gradientCallback, &releaseCGGradientLookupInfo };
+        CGFunctionRef function = CGFunctionCreate (info, 1, 0, 4, 0, &callbacks);
